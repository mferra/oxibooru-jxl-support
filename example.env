# Database credentials
POSTGRES_USER=oxi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=oxi
POSTGRES_PORT=5432

# This shows up on the homescreen, indicating build information
BUILD_INFO=latest

# Port to expose HTTP service
# Set to 127.0.0.1:8080 if you wish to reverse-proxy the docker's port,
# otherwise the port specified here will be publicly accessible
PORT=8080

# URL base to run oxibooru under
# See "Additional Features" section in INSTALL.md
BASE_URL=/

# Directory to store image data
MOUNT_DATA=/var/local/oxibooru/data

# Directory to store database files
MOUNT_SQL=/var/local/oxibooru/sql

# Seconds a single FFmpeg invocation (video/AVIF frame extraction, audio probing)
# may run before it is killed and the post is skipped. Defaults to 120.
# Raise it if large videos are being skipped during regenerate_thumbnails.
FFMPEG_TIMEOUT=120

# Seconds a GIF transcode (WebP/AV1 re-encoding) may run before it is killed.
# Defaults to 600. Re-encoding is legitimately slow, so this only exists to catch
# a wedged FFmpeg; raise it if long GIFs fail to convert.
FFMPEG_TRANSCODE_TIMEOUT=600
